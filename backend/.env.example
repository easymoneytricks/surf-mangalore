NODE_ENV=development
PORT=4000
API_PREFIX=/api
API_VERSION=v1
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<TRANSACTION_POOLER_HOST>:6543/<DB_NAME>?pgbouncer=true&connection_limit=1
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5180,http://localhost:4173,https://<PUBLIC_FRONTEND_DOMAIN>,https://<ADMIN_DOMAIN>
FRONTEND_ORIGIN=https://<PUBLIC_FRONTEND_DOMAIN>
ADMIN_ORIGIN=https://<ADMIN_DOMAIN>
PUBLIC_SITE_URL=https://<PUBLIC_SITE_DOMAIN>
CORS_EXTRA_ORIGINS=
LOG_LEVEL=info
JWT_ACCESS_SECRET=<REPLACE_WITH_STRONG_RANDOM_SECRET>
JWT_REFRESH_SECRET=<REPLACE_WITH_DIFFERENT_STRONG_RANDOM_SECRET>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=surfmangalore-backend
JWT_AUDIENCE=surfmangalore-admin-cms
AUTH_COOKIE_NAME=sm_refresh_token
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax
REFRESH_TOKEN_COOKIE_MAX_AGE_MS=604800000
AUTH_LOGIN_WINDOW_MS=600000
AUTH_LOGIN_MAX_ATTEMPTS=8
AUTH_REFRESH_WINDOW_MS=600000
AUTH_REFRESH_MAX_ATTEMPTS=25
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_PREFIX=surfmangalore/cms
SEED_ADMIN_PASSWORD=<DEVELOPMENT_ONLY_STRONG_PASSWORD>
MEDIA_ENABLE_AV_SCANNING=false
