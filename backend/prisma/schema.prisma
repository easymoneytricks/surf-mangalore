  updatedBy           AdminUser?    @relation("TestimonialUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([publishStatus])
  @@index([rating])
  @@index([coachId])
  @@index([deletedAt])
}

// ==========================================================
// SEO and Site Configuration
// ==========================================================

model SEOPage {
  id                  Int           @id @default(autoincrement())
  uuid                String        @unique @default(uuid())
  slug                String        @unique
  name                String
  title               String
  description         String?
  status              String        @default("active")
  publishStatus       PublishStatus @default(DRAFT)
  visibility          Visibility    @default(PUBLIC)
  routePath           String
  canonicalUrl        String?
  metaTitle           String
  metaDescription     String?
  metaKeywords        String[]
  robots              String?
  openGraphTitle      String?
  openGraphDescription String?
  openGraphImage      String?
  schemaJson          Json?
  localeCode          String?       @default("en")
  lessonId            Int?
  experienceId        Int?
  eventId             Int?
  createdById         Int?
  updatedById         Int?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?

  locale              Locale?       @relation(fields: [localeCode], references: [code], onDelete: SetNull)
  lesson              Lesson?       @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  experience          Experience?   @relation(fields: [experienceId], references: [id], onDelete: SetNull)
  event               Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdBy           AdminUser?    @relation("SEOPageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy           AdminUser?    @relation("SEOPageUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([routePath, localeCode])
  @@index([status])
  @@index([publishStatus])
  @@index([deletedAt])
}

model SiteSetting {
  id                  Int             @id @default(autoincrement())
  uuid                String          @unique @default(uuid())
  slug                String          @unique
  name                String
  title               String
  description         String?
  status              String          @default("active")
  settingKey          String          @unique
  settingType         SiteSettingType @default(STRING)
  valueString         String?
  valueNumber         Decimal?        @db.Decimal(14, 4)
  valueBoolean        Boolean?
  valueJson           Json?
  isPublic            Boolean         @default(false)
  createdById         Int?
  updatedById         Int?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  deletedAt           DateTime?

  createdBy           AdminUser?      @relation("SiteSettingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy           AdminUser?      @relation("SiteSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([isPublic])
  @@index([deletedAt])
}

model Navigation {
  id                  Int            @id @default(autoincrement())
  uuid                String         @unique @default(uuid())
  slug                String         @unique
  name                String
  title               String
  description         String?
  status              String         @default("active")
  publishStatus       PublishStatus  @default(DRAFT)
  visibility          Visibility     @default(PUBLIC)
  navigationType      NavigationType @default(HEADER)
  label               String
  href                String
  icon                String?
  parentId            Int?
  localeCode          String?        @default("en")
  sortOrder           Int            @default(0)
  createdById         Int?
  updatedById         Int?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?

  parent              Navigation?    @relation("NavigationTree", fields: [parentId], references: [id], onDelete: SetNull)
  children            Navigation[]   @relation("NavigationTree")
  locale              Locale?        @relation(fields: [localeCode], references: [code], onDelete: SetNull)
  createdBy           AdminUser?     @relation("NavigationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy           AdminUser?     @relation("NavigationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([publishStatus])
  @@index([navigationType])
  @@index([parentId])
  @@index([sortOrder])
  @@index([deletedAt])
}

model FooterLink {
  id                  Int           @id @default(autoincrement())
  uuid                String        @unique @default(uuid())
  slug                String        @unique
  name                String
  title               String
  description         String?
  status              String        @default("active")
  publishStatus       PublishStatus @default(DRAFT)
  visibility          Visibility    @default(PUBLIC)
  section             String
