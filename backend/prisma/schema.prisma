  href                String
  icon                String?
  localeCode          String?       @default("en")
  sortOrder           Int           @default(0)
  createdById         Int?
  updatedById         Int?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?

  locale              Locale?       @relation(fields: [localeCode], references: [code], onDelete: SetNull)
  createdBy           AdminUser?    @relation("FooterLinkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy           AdminUser?    @relation("FooterLinkUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([publishStatus])
  @@index([section])
  @@index([sortOrder])
  @@index([deletedAt])
}
